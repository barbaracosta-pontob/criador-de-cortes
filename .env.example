# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Modelo Claude usado para detecção de cortes
CLAUDE_MODEL=claude-sonnet-4-6

# faster-whisper
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
# auto | cpu | cuda

# Opcional: reusar a venv de outro projeto (ex: pontob-video-editor) em vez de
# criar uma venv local. Aponte para o python.exe da venv que já tem faster-whisper.
# WHISPER_PYTHON=C:\Users\...\pontob-video-editor\services\transcription\.venv\Scripts\python.exe

# Pasta onde os jobs são persistidos (pode apontar pra disco externo)
JOBS_DIR=./jobs

# Porta do Next.js
PORT=3100
