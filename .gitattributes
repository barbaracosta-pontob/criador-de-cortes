# Normalizacao de fim de linha.
# Sem isto, cada maquina grava CRLF (Windows) ou LF (Linux/Mac) e o git marca o
# arquivo inteiro como modificado. Regra: no repositorio, tudo fica LF; no
# checkout, tudo vem LF — exceto scripts do Windows, que precisam de CRLF.

# Default: git detecta se e texto e normaliza para LF.
* text=auto eol=lf

# --- Codigo e configuracao (LF) ---
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.example       text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# --- Scripts do Windows (CRLF obrigatorio) ---
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# --- Binarios (nunca normalizar) ---
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.svg   text eol=lf
*.mp4   binary
*.mov   binary
*.mkv   binary
*.webm  binary
*.m4v   binary
*.avi   binary
*.mp3   binary
*.wav   binary
*.bin   binary
*.pt    binary
*.onnx  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
